diff -Nur u-boot-2022.07-rc3/board/mediatek/mt7629/mt7629_rfb.c nwa50ax_pro/710p4c0_nwa50ax_pro/src/u-boot/board/mediatek/mt7629/mt7629_rfb.c
--- u-boot-2022.07-rc3/board/mediatek/mt7629/mt7629_rfb.c	2022-05-23 21:40:41.000000000 +0200
