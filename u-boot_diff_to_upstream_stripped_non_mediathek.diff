+#include <mapmem.h>
+#include <asm/unaligned.h>
+
+#define NUMOFIMAGE		2
+#define BOOTCONFIG_OFFSET	0xef00000 //checked by "mtd list" command
+#define BOOTCONFIG_LOAD_ADDR	0x5ff00000
+#define BOOTCONFIG_SIZE		0x20000
+
+#define DUALIMAGE_IMGSTATE_MASK 	0xc
+#define DUALIMAGE_IMGLOG_MASK 		0x2
+#define BOOTIMAGE_IMAGE_MASK 		0x1
+
