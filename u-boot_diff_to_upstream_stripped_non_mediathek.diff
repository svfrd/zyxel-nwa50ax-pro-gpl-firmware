+static const struct data_part_entry snand_parts[] = {
+	{
+		.name = "Bootloader",
+		.abbr = "bl",
+		.env_name = "bootfile.bl",
+		.write = write_bl,
+		.post_action = UPGRADE_ACTION_CUSTOM,
+		.do_post_action = erase_env,
+	},
+	{
+		.name = "Firmware",
+		.abbr = "fw",
+		.env_name = "bootfile",
+		.post_action = UPGRADE_ACTION_BOOT,
+		.write = write_firmware,
+	},
+	{
