+#define PART_NAME_BOOTLOADER 		"fip"
+#define PART_NAME_BOOTLOADER_ENV 	"u-boot-env"
+#define PART_NAME_MRD "mrd"
+
+#define posOfStartbit(b,n,m) \
+({ int def = b; \
+int len=0; \
+n=0;	\
+m=0;	\
+while (def) { \
+        if(def & 1 ) {break;} \
+        n ++; \
+        def = def >> 1; \
+};  \
+while (def) { \
+        if((def & 1) ==0) {break;} \
+        len ++; \
+        def = def >> 1; \
+};  \
+m = (1 << len) - 1; \
+})
+
+typedef enum{
