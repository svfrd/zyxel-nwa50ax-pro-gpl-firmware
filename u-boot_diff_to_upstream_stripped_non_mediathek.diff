+	if (!mtd)
+		return -ENODEV;
+
+	ret = mtd_erase_env(mtd, CONFIG_ENV_OFFSET, CONFIG_ENV_SIZE);
+
+	put_mtd_device(mtd);
+
+	return ret;
+#else
+	return 0;
+#endif
+}
+
+static const struct data_part_entry snand_parts[] = {
+	{
+		.name = "ATF BL2",
+		.abbr = "bl2",
+		.env_name = "bootfile.bl2",
