+#endif
+
+	ret = mtd_read_generic(mtd, offset, (void *)data_load_addr,
+			       mtd->writesize);
+	if (ret)
+		return ret;
+
+	switch (genimg_get_format((const void *)data_load_addr)) {
+#if defined(CONFIG_LEGACY_IMAGE_FORMAT)
