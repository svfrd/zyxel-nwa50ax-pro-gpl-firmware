+	/* Set normal_update to upgrade */
+	snprintf(runcmd, sizeof(runcmd),
+			"setenv normal_update 1 && imgaddr=0x%"PRIx32" && tftpboot $imgaddr %s && iminfo $imgaddr && source $imgaddr:script",
+			dfl_load_addr, net_boot_file_name);
