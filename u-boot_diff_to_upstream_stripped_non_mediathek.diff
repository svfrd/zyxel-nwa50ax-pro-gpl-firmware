diff -Nur u-boot-2022.07-rc3/drivers/mtd/mtk-snand/mtk-snand-ecc.c nwa50ax_pro/710p4c0_nwa50ax_pro/src/u-boot/drivers/mtd/mtk-snand/mtk-snand-ecc.c
