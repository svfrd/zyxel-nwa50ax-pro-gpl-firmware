+	uint8_t FeatureBit; /* Main Feature Bits */
+	uint8_t Reserved3;
+	uint8_t EtherAddr[6];
+	uint8_t CountryCode;
+	uint8_t AreaCode;
+} __attribute__((__packed__)) MRD;
+
+struct ImageInfo
+{
+	ImageState state;
+	int log;
+	uint32_t age;
+};
+
+struct dualImageInfo
+{
+	int bootImage;
+	int upgradeImage;
+	struct ImageInfo image[NUMOFIMAGE];
+};
