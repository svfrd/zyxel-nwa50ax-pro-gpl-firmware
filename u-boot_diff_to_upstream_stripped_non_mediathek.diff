+static int do_atnx(struct cmd_tbl *cmdtp, int flag, int argc, char * const argv[])
+{
+	char runcmd[256];
+	uint32_t dfl_load_addr = CONFIG_SYS_LOAD_ADDR;
+
+	if (argc == 2) {
+		copy_filename(net_boot_file_name, argv[1],
+				sizeof(net_boot_file_name));
+	} else {
+		/* CONFIG_USE_BOOTFILE and CONFIG_BOOTFILE must be set in include/config/xxx_defconfig first */
+		copy_filename(net_boot_file_name, env_get("bootfile"),
+				sizeof(net_boot_file_name));
+	}
+
+	/* Unset normal_update to upgrade */
+	snprintf(runcmd, sizeof(runcmd),
+			"setenv normal_update; imgaddr=0x%"PRIx32" && tftpboot $imgaddr %s && iminfo $imgaddr && source $imgaddr:script",
+			dfl_load_addr, net_boot_file_name);
+
+	return run_command(runcmd, 0);
+}
+U_BOOT_CMD(
+		atnx, 2, 0, do_atnx,
