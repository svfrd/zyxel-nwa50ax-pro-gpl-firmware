+	snor = board_get_snor_dev();
+	if (!snor)
+		return -ENODEV;
+
+	ret = snor_erase_generic(snor, 0, size);
+	if (ret)
+		return ret;
+
+	return snor_write_generic(snor, 0, 0, data, size, false);
+}
