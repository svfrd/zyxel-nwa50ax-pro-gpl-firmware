+		copy_filename(net_boot_file_name, argv[1],
+				sizeof(net_boot_file_name));
+	else
+		return CMD_RET_USAGE;
+
+	if (bl2_write())
+		return CMD_RET_FAILURE;
+
+	return CMD_RET_SUCCESS;
+}
+U_BOOT_CMD(
+	atbl, 2, 0, do_atbl,
+	"Upload and program bl2 (bl2.img) via tftp.",
+	"[filename]"
+);
